{
  "name": "angular-shared-components",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve demo --configuration development",
    "dev": "ng serve demo --configuration development",
    "ng": "ng",
    "build": "npm run build:libs && npm run build:demo",
    "build:libs": "npm run build:shared-ui-core && npm run build:shared-ui-theme && npm run build:shared-ui-primitives && npm run build:shared-ui-forms && npm run build:shared-ui-feedback && npm run build:shared-ui-list && npm run build:shared-ui-layout",
    "build:shared-ui-core": "ng build shared-ui-core",
    "build:shared-ui-theme": "ng build shared-ui-theme",
    "build:shared-ui-primitives": "ng build shared-ui-primitives",
    "build:shared-ui-forms": "ng build shared-ui-forms",
    "build:shared-ui-list": "ng build shared-ui-list",
    "build:shared-ui-layout": "ng build shared-ui-layout",
    "build:shared-ui-feedback": "ng build shared-ui-feedback",
    "build:demo": "ng build demo",
    "start:demo": "ng serve demo --configuration development",
    "test": "npm run test:libs",
    "test:libs": "npm run test:shared-ui-core && npm run test:shared-ui-theme && npm run test:shared-ui-primitives && npm run test:shared-ui-forms && npm run test:shared-ui-list && npm run test:shared-ui-layout && npm run test:shared-ui-feedback",
    "test:shared-ui-core": "ng test shared-ui-core --watch=false --browsers=ChromeHeadlessCI --karma-config karma.conf.cjs",
    "test:shared-ui-theme": "ng test shared-ui-theme --watch=false --browsers=ChromeHeadlessCI --karma-config karma.conf.cjs",
    "test:shared-ui-primitives": "ng test shared-ui-primitives --watch=false --browsers=ChromeHeadlessCI --karma-config karma.conf.cjs",
    "test:shared-ui-forms": "ng test shared-ui-forms --watch=false --browsers=ChromeHeadlessCI --karma-config karma.conf.cjs",
    "test:shared-ui-list": "ng test shared-ui-list --watch=false --browsers=ChromeHeadlessCI --karma-config karma.conf.cjs",
    "test:shared-ui-layout": "ng test shared-ui-layout --watch=false --browsers=ChromeHeadlessCI --karma-config karma.conf.cjs",
    "test:shared-ui-feedback": "ng test shared-ui-feedback --watch=false --browsers=ChromeHeadlessCI --karma-config karma.conf.cjs",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "endOfLine": "auto",
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.27",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/forms": "^20.3.27",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.27",
    "@angular/router": "^20.3.27",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.31",
    "@angular/cli": "^20.3.31",
    "@angular/compiler-cli": "^20.3.27",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "material-icons": "^1.13.14",
    "ng-packagr": "^20.3.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2"
  }
}
