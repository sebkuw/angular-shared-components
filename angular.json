          }
        }
      }
    },
    "shared-ui-feedback": {
      "projectType": "library",
      "root": "projects/shared-ui-feedback",
      "sourceRoot": "projects/shared-ui-feedback/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
