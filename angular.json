            },
            "development": {
              "tsConfig": "projects/shared-ui-forms/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/shared-ui-forms/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "shared-ui-list": {
      "projectType": "library",
      "root": "projects/shared-ui-list",
      "sourceRoot": "projects/shared-ui-list/src",
      "prefix": "lib",
      "architect": {
