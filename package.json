{
  "name": "angular-shared-components",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "npm run build:libs",
    "build:libs": "npm run build:shared-ui-core && npm run build:shared-ui-theme && npm run build:shared-ui-forms && npm run build:shared-ui-list && npm run build:shared-ui-layout && npm run build:shared-ui-feedback",
    "build:shared-ui-core": "ng build shared-ui-core",
    "build:shared-ui-theme": "ng build shared-ui-theme",
    "build:shared-ui-forms": "ng build shared-ui-forms",
    "build:shared-ui-list": "ng build shared-ui-list",
    "build:shared-ui-layout": "ng build shared-ui-layout",
    "build:shared-ui-feedback": "ng build shared-ui-feedback",
    "test": "npm run test:libs",
    "test:libs": "npm run test:shared-ui-core && npm run test:shared-ui-theme && npm run test:shared-ui-forms && npm run test:shared-ui-list && npm run test:shared-ui-layout && npm run test:shared-ui-feedback",
    "test:shared-ui-core": "ng test shared-ui-core --watch=false --browsers=ChromeHeadless",
    "test:shared-ui-theme": "ng test shared-ui-theme --watch=false --browsers=ChromeHeadless",
    "test:shared-ui-forms": "ng test shared-ui-forms --watch=false --browsers=ChromeHeadless",
    "test:shared-ui-list": "ng test shared-ui-list --watch=false --browsers=ChromeHeadless",
    "test:shared-ui-layout": "ng test shared-ui-layout --watch=false --browsers=ChromeHeadless",
    "test:shared-ui-feedback": "ng test shared-ui-feedback --watch=false --browsers=ChromeHeadless"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.31",
    "@angular/cli": "^20.3.31",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.9.2"
  }
}
