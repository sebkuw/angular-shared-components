          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/shared-ui-theme/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared-ui-theme/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/shared-ui-theme/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "shared-ui-forms": {
      "projectType": "library",
      "root": "projects/shared-ui-forms",
