{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "shared-ui-core": {
      "projectType": "library",
      "root": "projects/shared-ui-core",
      "sourceRoot": "projects/shared-ui-core/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/shared-ui-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/shared-ui-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/shared-ui-core/tsconfig.spec.json"
          }
        }
      }
    },
    "shared-ui-theme": {
      "projectType": "library",
      "root": "projects/shared-ui-theme",
      "sourceRoot": "projects/shared-ui-theme/src",
